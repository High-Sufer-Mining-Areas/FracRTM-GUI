SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS
    /
    SUBSURFACE_TRANSPORT transport
      MODE GIRT
    /
  /
END

SUBSURFACE

GRID
  TYPE UNSTRUCTURED_EXPLICIT ../octree/full_mesh.uge
  GRAVITY 0.000000000000E+00 0.000000000000E+00 0.000000000000E+00
END

FLUID_PROPERTY
  DIFFUSION_COEFFICIENT 1.000000000000E-09
END

DATASET udfm_permeability
  FILENAME ../octree/mesh_permeability.h5
  HDF5_DATASET_NAME Permeability
END

DATASET udfm_porosity
  FILENAME ../octree/mesh_porosity.h5
  HDF5_DATASET_NAME Porosity
END

MATERIAL_PROPERTY matrix
  ID 1
  POROSITY 1.000000000000E-02
  TORTUOSITY 1.000000000000E-02
  LONGITUDINAL_DISPERSIVITY 2.500000000000E-03
  TRANSVERSE_DISPERSIVITY_H 2.500000000000E-04
  TRANSVERSE_DISPERSIVITY_V 2.500000000000E-05
  CHARACTERISTIC_CURVES default
  PERMEABILITY
    PERM_ISO 1.000000000000E-18
  /
END

MATERIAL_PROPERTY fracture
  ID 2
  POROSITY DATASET udfm_porosity
  TORTUOSITY 2.500000000000E-01
  LONGITUDINAL_DISPERSIVITY 2.500000000000E-03
  TRANSVERSE_DISPERSIVITY_H 2.500000000000E-04
  TRANSVERSE_DISPERSIVITY_V 2.500000000000E-05
  CHARACTERISTIC_CURVES default
  PERMEABILITY
    DATASET udfm_permeability
  /
END

CHARACTERISTIC_CURVES default
  SATURATION_FUNCTION VAN_GENUCHTEN
    M 5.000000000000E-01
    ALPHA 1.000000000000E-04
    LIQUID_RESIDUAL_SATURATION 1.000000000000E-01
    MAX_CAPILLARY_PRESSURE 1.000000000000E+08
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 5.000000000000E-01
    LIQUID_RESIDUAL_SATURATION 1.000000000000E-01
  /
END

CHEMISTRY
  PRIMARY_SPECIES
    H+
    HCO3-
    Ca++
    Tracer
    Tracer1
    Tracer2
  /
  SECONDARY_SPECIES
    OH-
    CO3--
    CO2(aq)
    CaCO3(aq)
    CaHCO3+
    CaOH+
  /
  PASSIVE_GAS_SPECIES
    CO2(g)
  /
  MINERALS
    Calcite
  /
  MINERAL_KINETICS
    Calcite
      RATE_CONSTANT 1.000000000000E-06 mol/m^2-sec
    /
  /
  DATABASE ../database/hanford.dat
  LOG_FORMULATION
  ACTIVITY_COEFFICIENTS TIMESTEP
  OUTPUT
    PH
    PRIMARY_SPECIES
    TOTAL
    ALL
    MINERAL_RATE
    MINERAL_SATURATION_INDEX
  /
END

TIME
  FINAL_TIME 2.000000000000E+01 y
  INITIAL_TIMESTEP_SIZE 1.000000000000E+00 h
  MAXIMUM_TIMESTEP_SIZE 1.000000000000E+00 month
END

NUMERICAL_METHODS FLOW
  NEWTON_SOLVER
    ITOL 1.000000000000E-08
  /
  LINEAR_SOLVER
    SOLVER ITERATIVE
  /
END

NUMERICAL_METHODS TRANSPORT
  NEWTON_SOLVER
    ITOL 1.000000000000E-08
  /
  LINEAR_SOLVER
    SOLVER ITERATIVE
  /
END

REGION all
  COORDINATES
    -7.5 -7.5 -7.5
    7.5 7.5 7.5
  /
/

REGION top
  FILE ../octree/boundary_top.ex
/

REGION bottom
  FILE ../octree/boundary_bottom.ex
/

REGION west
  FILE ../octree/boundary_left_w.ex
/

REGION east
  FILE ../octree/boundary_right_e.ex
/

REGION north
  FILE ../octree/boundary_front_n.ex
/

REGION south
  FILE ../octree/boundary_back_s.ex
/

FLOW_CONDITION initial
  TYPE
      LIQUID_PRESSURE DIRICHLET
    /
    LIQUID_PRESSURE 1013250 Pa
/

FLOW_CONDITION outflow
  TYPE
      LIQUID_PRESSURE DIRICHLET
    /
    LIQUID_PRESSURE 1000000 Pa
/

FLOW_CONDITION inflow
  TYPE
      LIQUID_PRESSURE DIRICHLET
    /
    LIQUID_PRESSURE 1050000 Pa
/

CONSTRAINT initial_constraint
  CONCENTRATIONS
    H+ 1e-08 F
    HCO3- 0.001 G CO2(g)
    Ca++ 0.00052 M Calcite
    Tracer 1e-08 F
    Tracer1 0.00173 F
    Tracer2 0.00052 F
  /
  MINERALS
    Calcite 1e-05 1 m^2/m^3
  /
END

CONSTRAINT inlet_constraint
  CONCENTRATIONS
    H+ 4 P
    HCO3- 0.001 T
    Ca++ 1e-06 T
    Tracer 0.0001 F
    Tracer1 0.001 F
    Tracer2 1e-06 F
  /
END

TRANSPORT_CONDITION background_conc
  TYPE DIRICHLET_ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 initial_constraint
  /
/

TRANSPORT_CONDITION outflow_conc
  TYPE ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 initial_constraint
  /
/

TRANSPORT_CONDITION inlet_conc
  TYPE DIRICHLET_ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 inlet_constraint
  /
/


INITIAL_CONDITION initial
  FLOW_CONDITION initial
  TRANSPORT_CONDITION background_conc
  REGION all
/

BOUNDARY_CONDITION outlet
  FLOW_CONDITION outflow
  TRANSPORT_CONDITION outflow_conc
  REGION east
/

BOUNDARY_CONDITION inlet
  FLOW_CONDITION inflow
  TRANSPORT_CONDITION inlet_conc
  REGION west
/

STRATA
  FILE ../octree/materials.h5
/


OUTPUT
  VELOCITY_AT_CENTER
  SNAPSHOT_FILE
    PERIODIC TIME 6.000000000000E+00 month
    FORMAT HDF5 SINGLE_FILE
    VARIABLES
      LIQUID_PRESSURE
      POROSITY
      PERMEABILITY
    /
  /
  MASS_BALANCE_FILE
    PERIODIC TIMESTEP 1
    TOTAL_MASS_REGIONS
      east
    /
  /
END

END_SUBSURFACE
